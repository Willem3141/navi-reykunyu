<head>
	<meta charset="utf-8">
	<script>
		{
			<%# applies the theme chosen in the settings before rendering, it avoids flashing of the page #%>
			const theme = localStorage.getItem('reykunyu-theme');
			if (theme === 'light' || theme === 'dark') {
				document.documentElement.setAttribute('data-theme', theme);
			}
		}
	</script>
	<% if (locals['title']) { %>
		<title><%= locals['title'] %> &bull; Reykunyu</title>
	<% } else { %>
		<title>Reykunyu &ndash; Online Na'vi dictionary</title>
	<% } %>
	<link rel="stylesheet" type="text/css" href="/vendor/semantic/dist/semantic.min.css">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="Reykunyu is a user-friendly online Na'vi dictionary, supporting translations to and from English, German, French, and other languages.">
	<% if (locals['css']) { %>
		<link rel="stylesheet" type="text/css" href="/css/<%- css %>">
	<% } else { %>
		<link rel="stylesheet" type="text/css" href="/css/index.css">
	<% } %>
	<link rel="manifest" href="/manifest.webmanifest">
	<link rel="icon" type="image/png" href="/images/favicon.png">
	<link rel="search" type="application/opensearchdescription+xml" title="Reykunyu" href="/opensearch.xml">
</head>
